# Postair E2E suite — environment variables
#
# BASE_URL — target Angular app. Defaults to the local dev stack if unset.
BASE_URL=http://localhost:4200

# NODE_API_URL — target Node backend, for any direct API calls specs make
# (e.g. auth setup) rather than going through the UI.
NODE_API_URL=http://localhost:3000

# E2E_TEST_EMAIL — the seeded account from data-utils/seed_e2e_account.py.
E2E_TEST_EMAIL=e2e-test-writer@postair.test

# E2E_TEST_PASSWORD — NEVER put the real value here or in any committed file.
# Pull it from Doppler at run time instead:
#   doppler run --project postair --config dev_nk -- npm test
E2E_TEST_PASSWORD=

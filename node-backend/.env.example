# --- Backend (Node.js) ---
NODE_PORT=3000
NODE_ENV=dev
NODE_JWT_SECRET=your_jwt_secret
NODE_SESSION_SECRET=your_session_secret
NODE_SHARED_SECURITY_KEY=your_shared_security_key
NODE_FEATURE_AI_SEARCH=true   # set to false to disable AI search globally

# --- Services Discovery ---
PYTHON_SERVICE_URL=http://localhost:8000
